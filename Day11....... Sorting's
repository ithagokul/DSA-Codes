#Sorting
'''1.Bubble sort
2.Selection sort
3.Insertion sort'''

#Bubble sort
arr=list(map(int, input("Enter elements: ").split()))
n=len(arr)
for i in range(n):
    for j in range(0,n-1-i):
        if arr[j]>arr[j+1]:
            arr[j], arr[j+1]=arr[j+1], arr[j]
print(*arr)


#Selection sort
arr=list(map(int, input("Enter elements: ").split()))
n=len(arr)
for i in range(n-1):
    minindex= i
    for j in range(i+1, n):
        if arr[j]<arr[minindex]:
            minindex= j
    arr[i], arr[minindex]= arr[minindex], arr[i]
print(*arr)


#Insertion sort
arr=list(map(int, input("Enter elements: ").split()))
for i in range(1, len(arr)):
    key= arr[i]
    j=i-1
    while j>=0 and arr[j]>key :
        arr[j+1] = arr[j]
        j-= 1
    arr[j+1] = key
print(*arr)





























