#1.spiral order traversal
#2.spiral order pattern

n=int(input("Enter the size: "))
a= [[0] *n for _ in range(n)]
print(a)
top= 0
bottom =n-1
left=0
right= n-1
num=1
while top<=bottom and left<=right:
    #travse at top from left ->right
    for i in range(left, right+1):
        a[top][i]= num
        num+=1
    top+=1
    #travse at right from top->bottom
    for i in range(top, bottom+1):
        a[i][right]=num
        num+=1
    right-=1
    #travase at bottom from right-> left
    for i in range (right, left-1, -1):
        a[bottom][i]= num
        num+=1
    bottom-=1
    #travase at left from bottom -> top
    for i in range(bottom, top-1, -1):
        a[i][left]= num
        num+=1
    left+=1
for row in a:
    for val in row:
        print(f"{val:3}", end=' ')
    print()

